# Copy to medicine/.env on the Raspberry Pi and replace placeholder values.

# Active Neon PostgreSQL database (production / main branch)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-prod-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon branch for legacy main-old deployment (reference only)
DATABASE_URL_MAIN_OLD="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-main-old-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Legacy Supabase reference (from pre-Neon setup; unused by main scripts)
SUPABASE_URL_OLD="https://your-project-ref.supabase.co"
SUPABASE_KEY_OLD="YOUR_LEGACY_SUPABASE_KEY_HERE"

# Device metadata
DEVICE_ID="raspberry_pi_01"
POLL_INTERVAL="2"
